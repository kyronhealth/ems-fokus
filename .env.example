# Copy to .env.local and fill in. Never commit real keys.
# Supabase > Project settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Shown on the buy page; the real price lives in Stripe
VITE_PRICE_LABEL=CHF 49
# Only for scripts/import-content.mjs, run on your own computer
SUPABASE_SERVICE_ROLE_KEY=
